# Block node_modules
node_modules/
**/node_modules/

# Block all lock files except package-lock.json (force npm install on server)
yarn.lock
**/yarn.lock
pnpm-lock.yaml
**/pnpm-lock.yaml
package-lock.json

# Block pnpm workspace config
pnpm-workspace.yaml

# Block build output
.expo/
dist/
web-build/
*.tsbuildinfo

# Block unnecessary files
*.html
*.sql
*.md
.vercel/
.kilocode/
.aider.chat.history.md
.aider.input.history
